-- =================================================================
-- AREA 51 [ALPHA] - ULTIMATE EVENT MENU BY AI
-- FEATURES: INSTANT TP ITEM, FULLBRIGHT, ESP MOBS, ESP ITEMS
-- =================================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local localPlayer = Players.LocalPlayer

-- Tạo Giao Diện Menu GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Area51UltimateGui"
ScreenGui.Parent = localPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

-- Khung chính của Menu (Mở rộng kích thước để chứa thêm nút)
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 280, 0, 340)
MainFrame.Position = UDim2.new(0.5, -140, 0.3, -170)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Parent = ScreenGui

local FrameCorner = Instance.new("UICorner")
FrameCorner.CornerRadius = UDim.new(0, 10)
FrameCorner.Parent = MainFrame

-- Tiêu đề Menu
local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, 0, 0, 40)
TitleLabel.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
TitleLabel.Text = "  AREA 51 - ULTIMATE EVENT HACK"
TitleLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
TitleLabel.Font = Enum.Font.SourceSansBold
TitleLabel.TextSize = 15
TitleLabel.Parent = MainFrame

local TitleCorner = Instance.new("UICorner")
TitleCorner.CornerRadius = UDim.new(0, 10)
TitleCorner.Parent = TitleLabel

-- Hiển thị trạng thái hoạt động của Auto TP
local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, -20, 0, 25)
StatusLabel.Position = UDim2.new(0, 10, 0, 45)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = "Auto TP: ĐANG TẮT"
StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
StatusLabel.Font = Enum.Font.SourceSans
StatusLabel.TextSize = 14
StatusLabel.Parent = MainFrame

-- HÀM TẠO NÚT BẤM NHANH (Helper Function)
local function createButton(name, text, pos, color)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, -20, 0, 42)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.Parent = MainFrame
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    return btn
end

-- Tạo các nút bấm trên giao diện
local ToggleButton = createButton("ToggleTP", "BẬT AUTO TP & NHẬN LẬP TỨC", UDim2.new(0, 10, 0, 75), Color3.fromRGB(180, 50, 50))
local BrightButton = createButton("ToggleBright", "BẬT FULLBRIGHT (SÁNG MAP)", UDim2.new(0, 10, 0, 125), Color3.fromRGB(60, 60, 75))
local EspMobButton = createButton("ToggleEspMob", "BẬT ESP MOB (XUYÊN TƯỜNG QUÁI)", UDim2.new(0, 10, 0, 175), Color3.fromRGB(60, 60, 75))
local EspItemButton = createButton("ToggleEspItem", "BẬT ESP ITEM (XUYÊN TƯỜNG NÚT E)", UDim2.new(0, 10, 0, 225), Color3.fromRGB(60, 60, 75))

-- Code giúp Menu có thể kéo di chuyển (Draggable)
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
MainFrame.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
UserInputService.InputChanged:Connect(function(input) if input == dragInput and dragging then local delta = input.Position - dragStart; MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end end)

-- =================================================================
-- 1. LOGIC AUTO TP & NHẬN ĐỒ LẬP TỨC
-- =================================================================
local autoEnabled = false
local function collectEItemsInstant()
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end

    for _, obj in pairs(game.Workspace:GetDescendants()) do
        if not autoEnabled then break end
        if obj:IsA("ProximityPrompt") and obj.KeyboardKeyCode == Enum.KeyCode.E then
            local parentObj = obj.Parent
            if parentObj and parentObj:IsA("BasePart") and not parentObj:IsDescendantOf(character) and not game.Players:GetPlayerFromCharacter(parentObj.Parent) then
                StatusLabel.Text = "Đang lấy: " .. parentObj.Name
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
                
                obj.HoldDuration = 0 -- Ép thời gian giữ về 0
                local oldCFrame = humanoidRootPart.CFrame
                humanoidRootPart.CFrame = parentObj.CFrame * CFrame.new(0, 2.5, 0)
                task.wait(0.15)
                fireproximityprompt(obj)
                task.wait(0.1)
                humanoidRootPart.CFrame = oldCFrame
                task.wait(0.1)
            end
        end
    end
end

ToggleButton.MouseButton1Click:Connect(function()
    autoEnabled = not autoEnabled
    if autoEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        ToggleButton.Text = "TẮT AUTO INSTANT"
        StatusLabel.Text = "Auto TP: ĐANG QUÉT VẬT PHẨM..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
        task.spawn(function()
            while autoEnabled do
                collectEItemsInstant()
                task.wait(1.0)
                if autoEnabled then StatusLabel.Text = "Auto TP: Đang đợi vật phẩm mới..."; StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200) end
            end
        end)
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        ToggleButton.Text = "BẬT AUTO TP & NHẬN LẬP TỨC"
        StatusLabel.Text = "Auto TP: ĐANG TẮT"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end)

-- =================================================================
-- 2. LOGIC FULLBRIGHT (SÁNG MAP)
-- =================================================================
local brightEnabled = false
local oldBrightness = Lighting.Brightness
local oldClockTime = Lighting.ClockTime
local oldAmbient = Lighting.Ambient

BrightButton.MouseButton1Click:Connect(function()
    brightEnabled = not brightEnabled
    if brightEnabled then
        BrightButton.BackgroundColor3 = Color3.fromRGB(0, 150, 136)
        BrightButton.Text = "TẮT FULLBRIGHT"
        -- Bật chế độ siêu sáng bẻ gãy bóng tối ban đêm
        Lighting.Brightness = 4
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.GlobalShadows = false
    else
        BrightButton.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        BrightButton.Text = "BẬT FULLBRIGHT (SÁNG MAP)"
        -- Trả lại ánh sáng gốc của game
        Lighting.Brightness = oldBrightness
        Lighting.ClockTime = oldClockTime
        Lighting.Ambient = oldAmbient
        Lighting.GlobalShadows = true
    end
end)

-- =================================================================
-- 3. LOGIC ESP MOBS (XUYÊN TƯỜNG QUÁI VẬT)
-- =================================================================
local espMobEnabled = false
local mobFolder = game.Workspace:FindFirstChild("Zombies") or game.Workspace:FindFirstChild("Monsters") or game.Workspace -- Area 51 thường xếp quái vào thư mục riêng hoặc Workspace

local function applyEspMob(model)
    if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") and model.Name ~= localPlayer.Name and not game.Players:GetPlayerFromCharacter(model) then
        -- Tạo khung Highlight phát sáng xuyên tường màu đỏ cho quái vật
        local highlight = Instance.new("Highlight")
        highlight.Name = "MobEspHighlight"
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.Adornee = model
        highlight.Parent = model
    end
end

EspMobButton.MouseButton1Click:Connect(function()
    espMobEnabled = not espMobEnabled
    if espMobEnabled then
        EspMobButton.BackgroundColor3 = Color3.fromRGB(233, 30, 99)
        EspMobButton.Text = "TẮT ESP MOB"
        for _, v in pairs(mobFolder:GetChildren()) do applyEspMob(v) end
    else
        EspMobButton.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        EspMobButton.Text = "BẬT ESP MOB (XUYÊN TƯỜNG QUÁI)"
        for _, v in pairs(game.Workspace:GetDescendants()) do
            if v.Name == "MobEspHighlight" then v:Destroy() end
        end
    end
end)

-- =================================================================
-- 4. LOGIC ESP ITEM (XUYÊN TƯỜNG NÚT BẤM E / VẬT PHẨM EVENT)
-- =================================================================
local espItemEnabled = false

local function applyEspItem(obj)
    if obj:IsA("ProximityPrompt") and obj.KeyboardKeyCode == Enum.KeyCode.E then
        local parentObj = obj.Parent
        if parentObj and parentObj:IsA("BasePart") and not parentObj:IsDescendantOf(localPlayer.Character) then
            -- Tạo hộp Box phát sáng màu lục xung quanh nút E
            local highlight = Instance.new("Highlight")
            highlight.Name = "ItemEspHighlight"
            highlight.FillColor = Color3.fromRGB(0, 255, 100)
            highlight.FillTransparency = 0.4  
local function applyEspItem(obj)
    if obj:IsA("ProximityPrompt") and obj.KeyboardKeyCode == Enum.KeyCode.E then
        local parentObj = obj.Parent
        if parentObj and parentObj:IsA("BasePart") and not parentObj:IsDescendantOf(localPlayer.Character) then
            -- Tạo hiệu ứng Highlight phát sáng
            local highlight = Instance.new("Highlight")
            highlight.Name = "ItemEspHighlight"
            highlight.FillColor = Color3.fromRGB(0, 255, 100)
            highlight.FillTransparency = 0.4
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.Parent = parentObj
            
            -- Tạo thẻ tên (BillboardGui) nổi trên đầu vật phẩm để thấy tên từ xa
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "ItemEspText"
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.AlwaysOnTop = true
            billboard.StudsOffset = Vector3.new(0, 2, 0)
            billboard.Parent = parentObj
            
            -- Tạo chữ hiển thị tên vật phẩm
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "[ " .. parentObj.Name .. " ]"
            label.TextColor3 = Color3.fromRGB(0, 255, 255)
            label.Font = Enum.Font.SourceSansBold
            label.TextSize = 13
            label.Parent = billboard
        end
    end
end

-- Sự kiện bấm nút Bật/Tắt ESP Item trên Menu
EspItemButton.MouseButton1Click:Connect(function()
    espItemEnabled = not espItemEnabled
    
    if espItemEnabled then
        EspItemButton.BackgroundColor3 = Color3.fromRGB(63, 81, 181)
        EspItemButton.Text = "TẮT ESP ITEM"
        -- Quét để bật hiệu ứng phát sáng cho toàn bộ nút E hiện có
        for _, v in pairs(game.Workspace:GetDescendants()) do 
            applyEspItem(v) 
        end
    else
        EspItemButton.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        EspItemButton.Text = "BẬT ESP ITEM (XUYÊN TƯỜNG NÚT E)"
        -- Xóa bỏ toàn bộ hiệu ứng phát sáng và chữ hiển thị khi tắt tính năng
        for _, v in pairs(game.Workspace:GetDescendants()) do
            if v.Name == "ItemEspHighlight" or v.Name == "ItemEspText" then 
                v:Destroy() 
            end
        end
    end
end)
  
